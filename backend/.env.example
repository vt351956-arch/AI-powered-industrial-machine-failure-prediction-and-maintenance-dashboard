




# Backend Environment Variables
PROJECT_NAME="AI-Powered Predictive Maintenance for Industry 4.0"
ENV_MODE=development
DEBUG=True
API_V1_PREFIX=/api

# Security & JWT
SECRET_KEY=change-this-super-secret-key-min-32-chars-long-industry40-token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Connection
DATABASE_URL=postgresql+psycopg2://postgres:vaibhav123@localhost:5432/predictive_maintenance
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ML Model Directory (Relative to project root or backend)
MODEL_DIR=../ml/models
MODEL_VERSION=random-forest-v1

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
