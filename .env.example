# ========================================================
# AI-Powered Predictive Maintenance for Industry 4.0 - ENV
# ========================================================

# --- Application Configuration ---
PROJECT_NAME="AI-Powered Predictive Maintenance for Industry 4.0"
ENV_MODE=development
DEBUG=True
API_V1_PREFIX=/api

# --- Security & JWT ---
# IMPORTANT: Generate a secure 32+ character key for production (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-this-super-secret-key-min-32-chars-long-industry40-token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Configuration (PostgreSQL) ---
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:vaibhav123@localhost:5432/predictive_maintenance
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Machine Learning Engine ---
MODEL_DIR=ml/models
MODEL_VERSION=random-forest-v1
RETRAIN_SAMPLE_SIZE=5000

# --- CORS Settings ---
# Comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# --- Frontend Environment Variables (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api
